# ---------------------------------------------------------------------------
# Server-side AI credentials for /api/qualify (never expose to the browser)
# Optional — without these, the demo uses deterministic DEMO FALLBACK parsing.
# ---------------------------------------------------------------------------
# AI_API_KEY=
# AI_BASE_URL=https://api.x.ai/v1
# AI_MODEL=grok-2-latest
#
# XAI_API_KEY=
# XAI_BASE_URL=https://api.x.ai/v1
# XAI_MODEL=grok-2-latest
#
# OPENAI_API_KEY=
# AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-4o-mini

# ---------------------------------------------------------------------------
# Supabase (Phase 0 — connectivity only; Agent/CRM still use localStorage)
# Copy values from Supabase → Project Settings → API into Vercel / .env.local
# Never commit real values. Never put SERVICE_ROLE in NEXT_PUBLIC_*.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
